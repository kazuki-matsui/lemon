import('lime.lemon', 'mathUtils.lemon')

// single-line comment
/* multi-line
comment */

//variables
variable = object{
    string = "There are 7 values, those being strings, numbers, booleans, nulls, arrays sets and objects.",
    number = 2,
    boolean = false,
    noValue = null,
    // array is an ordered collection of values, their starting index is 1 similar to Lua and every empty index is treated as null
    array = [1, 2, 3, 4, 5]
}

constant constantVariable = 'Hello, I cannot be changed.'
//object is an ordered collection of values, they contain properties (variables), logic blocks and functions
numbers = object{
    one = variable.array[1],
    mistakes = 0
}

operationPrecedence = [
    "&", "|",
    "!=", "==", "=>", "<=", ">", "<",
    "+", "-",
    "*", "/", "%",
    "^"
]



// logic blocks
if('This string equals to variable' == variable) {
    output = false
} otherwise(true / variable == 0) { // the / operator also works like enhanced for loop where it gives the amount of something in somewhere
      output = true
}
/*every(boolean / variable) {
    boolean = boolean == false //inverts that boolean
}*/
repeat(5) {
    numbers.one = numbers.one + 1
}
while(numbers.one > 100) {
    numbers.one = numbers.one + 1
}



// function, in first field you define arguments and in second field you define return variable
function divide(left, right)(result) {
    check(left == 0 | left == null | right == 0 | right == null) {
        break // when you break out of function it returns null
    }
    result = left / right
}
// this is how you call a function
// numbers.one = divide(1, 100)()
// this is a constant function, you cannot declare a constant function inside of lemon, it's use is defined outside of lemon
